[Unit]
Description=GigAI Tools developer API task worker
After=network.target postgresql.service

[Service]
User=gigai
# Same working directory and settings as the backend, so relative paths such
# as data/apifiles point at the same files.
WorkingDirectory=/opt/gigai-tools/backend
EnvironmentFile=/opt/gigai-tools/backend/.env
ExecStart=/usr/bin/node /opt/gigai-tools/worker/worker.bundle.mjs
Restart=always
RestartSec=5
# Keep the worker from taking the memory the site and backend need.
MemoryMax=300M

[Install]
WantedBy=multi-user.target
