# GigAI Tools settings. Copy to .env (the website build) and backend/.env (the
# backend and worker) and fill in what you use. Every value is optional unless
# it says otherwise; a feature whose setting is empty stays off and says so.
# Never commit a real .env.

# ── Website build (NEXT_PUBLIC_*: baked into the static export) ─────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # canonical origin for metadata, sitemap and JSON-LD
NEXT_PUBLIC_API_URL=http://localhost:8000/api # the backend's /api base (Video -> Work, PDF repair)

# Analytics and search-engine verification
NEXT_PUBLIC_GA4_ID=                 # G-XXXXXXXXXX; loads gtag.js only when set
NEXT_PUBLIC_GSC_VERIFICATION=       # Google Search Console token
NEXT_PUBLIC_BING_VERIFICATION=      # Bing Webmaster Tools msvalidate.01 token

# Google AdSense: no ads load until the publisher ID is set
NEXT_PUBLIC_ADSENSE_CLIENT=         # ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_IN_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_MULTIPLEX=

NEXT_PUBLIC_LEADS_ENDPOINT=         # where the contact form POSTs; unset, it points at the site email
NEXT_PUBLIC_INSPECTOR_PROXY=        # Social Share Inspector fetch proxy (cloudflare/social-fetch); unset = paste HTML only
NEXT_PUBLIC_VTW_DEMO_SAMPLE=        # URL of a Video -> Work demo recording; unset hides the demo button
NEXT_PUBLIC_SERVER_CONVERT=         # true only if the backend has LibreOffice: Word<->PDF then try /api/convert first

# ── Backend (backend/.env) ───────────────────────────────────────────────────
ENV=development                     # production turns on the CORS pinning check
CORS_ORIGINS=http://localhost:3000  # comma-separated origins allowed to call the backend
VERIFY_EXTENSION_IDS=               # browser-extension IDs allowed to call /api/v1/verify
CORS_ORIGIN_REGEX=                  # leave empty; production refuses a loose pattern
MAX_UPLOAD_MB=25

# Video -> Work and GigAI Verify (the hosted-model features)
ANTHROPIC_API_KEY=
VIDEO_WORK_MODEL=claude-opus-5
VERIFY_MODEL=claude-opus-5
GROQ_API_KEY=                       # fallback for Video -> Work; the IconLab composer
GROQ_MODEL=openai/gpt-oss-120b
VIDEO_FETCH_ENABLED=true            # Loom/YouTube/Vimeo links via yt-dlp; false keeps uploads only
VIDEO_FETCH_MAX_MB=600
VIDEO_FETCH_MAX_MINUTES=90
VIDEO_FETCH_CONCURRENCY=2
VERIFY_MAX_TEXT_CHARS=200000
VERIFY_CONCURRENCY=4

# PDF repair (backend/app/pdf_repair, AGPL-3.0): needs requirements-pdf-repair.txt and tesseract
PDF_REPAIR_ENABLED=false

GIGAI_NEWSLETTER_DIR=data           # where newsletter sign-ups are stored

# ── Developer API (/v1, mounted only when GIGAI_API_JWT_SECRET is set) ───────
GIGAI_API_JWT_SECRET=               # required for /v1: a long random string
GIGAI_API_DSN=dbname=gigai_api user=gigai_api host=/var/run/postgresql
GIGAI_SITE_BASE=http://localhost:3000        # links in account email and poster pages
GIGAI_API_PUBLIC_BASE=http://localhost:8000  # base of signed file-download URLs
GIGAI_API_FILES_DIR=data/apifiles   # job files, deleted on their retention schedule
GIGAI_POSTER_DIR=data/poster
GIGAI_POSTER_MAX_PAGES=3
GIGAI_POSTER_MAX_TOTAL_MB=400
GIGAI_TOOLS_ROOT=../out             # the website's static export (poster pages reuse its shell)
GIGAI_ADMIN_EMAILS=                 # comma-separated accounts allowed into /v1/admin
GIGAI_ALLOW_LOOPBACK_WEBHOOKS=      # local testing only; leave unset in production

# Account email (verification and password reset). Unset: accounts are verified automatically.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional LLM keys for the site-audit and agent planners (free tiers work)
GIGAI_AUDIT_GROQ_KEY=
GIGAI_AUDIT_GEMINI_KEY=
GIGAI_AGENT_GROQ_KEY=
GIGAI_AGENT_GEMINI_KEY=

# ── Task worker (reads backend/.env) ─────────────────────────────────────────
GIGAI_PDFJS_ASSETS=                 # folder with pdf.js cmaps and standard_fonts
GIGAI_OCR_BASE=http://127.0.0.1:8000/api/pdf-repair
